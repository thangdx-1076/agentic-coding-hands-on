# Copy to `.env.local` for local dev. On Vercel these live in
# Project Settings → Environment Variables (see docs/deployment.md).
#
# Không commit `.env.local`. `.gitignore` chặn `.env*` trừ đúng file này.

# ---------------------------------------------------------------------------
# Supabase — bắt buộc, app chết ngay ở lần dùng đầu nếu thiếu
# ---------------------------------------------------------------------------
# Local:  http://127.0.0.1:55321  (port lấy từ supabase/config.toml, KHÔNG phải
#         54321 mặc định)
# Hosted: https://<project-ref>.supabase.co
#
# Hostname của biến này cũng quyết định `images.remotePatterns` và
# `dangerouslyAllowLocalIP` (src/configs/image-remote-patterns.ts). Host loopback
# ⇒ cờ SSRF bật (chỉ hợp lệ ở local); host public ⇒ tắt. Đổi biến này là đổi
# luôn hành vi của image optimizer.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Publishable key (thay cho anon key cũ). Next inline biến `NEXT_PUBLIC_*` vào
# bundle client — chỉ để key publishable ở đây, tuyệt đối không phải service role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Sự kiện — server-only, đọc trong src/proxy.ts, (home)/page.tsx, prelaunch/page.tsx
# ---------------------------------------------------------------------------
# ISO-8601 có offset. Thiếu hoặc sai định dạng ⇒ countdown về 00/00/00 và
# prelaunch lock coi như "chưa tới giờ" (BR-004), không throw.
EVENT_START_AT=2026-12-26T18:30:00+07:00

# Khóa toàn site về /prelaunch cho tới khi EVENT_START_AT tới. Chỉ chuỗi "true"
# mới bật; mọi giá trị khác (kể cả thiếu) là tắt.
PRELAUNCH_LOCK_ENABLED=false

# ---------------------------------------------------------------------------
# Supabase CLI — đọc từ `.env` ở gốc repo, KHÔNG phải `.env.local`
# ---------------------------------------------------------------------------
# `supabase/config.toml` bật `[auth.external.google]` và trỏ client_id/secret vào
# hai biến này. Thiếu ⇒ mọi lệnh `supabase *` in WARN "environment variable is
# unset", và Google login ở Supabase local không hoạt động.
#
# WARN này vô hại với `supabase db push` (push migration không đụng auth config),
# nhưng chặn `supabase start` phục vụ đăng nhập Google. Lấy credential từ Google
# Cloud Console, redirect URI phải khớp dòng `redirect_uri` trong config.toml:
# http://127.0.0.1:55321/auth/v1/callback
#
# Chép hai dòng dưới sang `.env` (cùng thư mục gốc) rồi điền giá trị thật.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Chỉ dùng cho test ở máy local — KHÔNG set trên Vercel
# ---------------------------------------------------------------------------
# Service role key, dùng để dọn dữ liệu trong e2e tag @local-db. Không có dòng
# code runtime nào trong src/ đọc biến này.
SERVICE_ROLE_KEY=
