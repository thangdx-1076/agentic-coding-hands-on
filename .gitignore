# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# storybook
/storybook-static/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/playwright/.auth/

# claude code / takumi kit
# The whole tree is a LOCAL install: it vendors node_modules and a Python
# .venv (site-packages, cacert.pem). Never commit it. The one exception is
# .tkm.json — sddMode is a project-level decision shared by everyone here.
.claude/*
!.claude/.tkm.json
# Project-authored skills ARE source, not vendored install output. Un-ignore
# the skills dir, re-ignore everything inside it (the kit drops node_modules /
# .venv there), then opt each hand-written skill back in by name.
!.claude/skills/
.claude/skills/*
!.claude/skills/separate-hook-logic-from-components/
!.claude/skills/write-unit-tests-and-storybook-stories/

# SunLint / licenseal report output (tool-owned, regenerated by /tkm:lint-code and /tkm:audit-licenses)
.takumi/
