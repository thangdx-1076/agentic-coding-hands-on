# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/playwright/.auth/

# claude code / takumi kit
# The whole tree is a LOCAL install: it vendors node_modules and a Python
# .venv (site-packages, cacert.pem). Never commit it. The one exception is
# .tkm.json — sddMode is a project-level decision shared by everyone here.
.claude/*
!.claude/.tkm.json
